                ],
                [
                  1192.0,
                  1608.0
                ],
                [
                  289.0,
                  1608.0
                ]
              ]
            },
            {
              "block_label": "text",
              "block_content": "6.2 在某些情况下，对本表的使用可根据需要作变通处理，但部首总数、序号及形体应与本部首表保持一致，并须对变通情况作出具体说明。",
              "block_bbox": [
                290,
                1623,
                2198,
                1740
              ],
              "block_id": 11,
              "block_order": 12,
              "group_id": 11,
              "block_polygon_points": [
                [
                  290.0,
                  1623.0
                ],
                [
                  2198.0,
                  1623.0
                ],
                [
                  2198.0,
                  1740.0
                ],
                [
                  290.0,
                  1740.0
                ]
              ]
            },
            {
              "block_label": "text",
              "block_content": "a 某些辞书（如大型字、词典，古汉语字、词典）可根据传统和实际需要，用繁体部首或变形、从属部首作为主部首。如“風（风）”、“貝（贝）”；“艸（艹）”、“辵（辶）”、玉（王）。",
              "block_bbox": [
                293,
                1754,
                2199,
                1873
              ],
              "block_id": 12,
              "block_order": 13,
              "group_id": 12,
              "block_polygon_points": [
                [
                  293.0,
                  1754.0
                ],
                [
                  2199.0,
                  1754.0
                ],
                [
                  2199.0,
                  1873.0
                ],
                [
                  293.0,
                  1873.0
                ]
              ]
            },
            {
              "block_label": "text",
              "block_content": "b 某些辞书可同时采用主部首和收字较多的附形部首。如王（玉），可将从“王”的字归入“王”部，将从“玉”的字归入“玉”部，两部的序号均为61。又如车（車），简、繁体都收的辞书可将简化字归入“车”部，将繁体字归入“車”部，两部的序号均为68。",
              "block_bbox": [
                290,
                1885,
                2202,
                2070
              ],
              "block_id": 13,
              "block_order": 14,
              "group_id": 13,
              "block_polygon_points": [
                [
                  290.0,
                  1885.0
                ],
                [
                  2202.0,
                  1885.0
                ],
                [
                  2202.0,
                  2070.0
                ],
                [
                  290.0,
                  2070.0
                ]
              ]
            },
            {
              "block_label": "text",
              "block_content": "c 用于旧印刷字形的检索时，可将本表的部首转换为旧印刷字形，部首序号不变。如“30 +”转换为“30 +”，“49 辶”转换为“49 辶”。新旧字形同时存在的字集中，旧字形可归入对应的新字形部首，如“黄”归入“黄”部，“青”归入“青”部。",
              "block_bbox": [
                292,
                2082,
                2203,
                2267
              ],
              "block_id": 14,
              "block_order": 15,
