            {
              "block_label": "text",
              "block_content": "6.1 使用本部首表时，一般应以主部首为主。",
              "block_bbox": [
                289,
                1556,
                1192,
                1608
              ],
              "block_id": 10,
              "block_order": 11,
              "group_id": 10,
              "block_polygon_points": [
                [
                  289.0,
